{
  "version": 2,
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/webhooks/whatsapp(.*)",
      "destination": "/api/webhooks/whatsapp"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
